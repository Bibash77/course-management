<h1>Courses</h1>
<a href="/courses/new" class="btn btn-primary">Add New Course</a>
<table class="table mt-3">
  <thead>
    <tr>
      <th>Title</th>
      <th>Code</th>
      <th>Semester</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#each courses}}
      <tr>
        <td>{{this.title}}</td>
        <td>{{this.code}}</td>
        <td>{{this.semester}}</td>
        <td>
          <a href="/courses/{{this._id}}" class="btn btn-info btn-sm">View</a>
          <form action="/courses/{{this._id}}?_method=DELETE" method="POST" style="display:inline;">
            <button class="btn btn-danger btn-sm">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>
