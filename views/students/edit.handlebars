<div class="container mt-4">
    <h2>Edit Student</h2>
    <form action="/students/{{student._id}}?_method=PUT" method="POST">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-control" value="{{student.name}}" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Roll No</label>
            <input type="text" name="roll_no" class="form-control" value="{{student.roll_no}}" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Symbol No</label>
            <input type="text" name="symbol_no" class="form-control" value="{{student.symbol_no}}" required>
        </div>
        <button type="submit" class="btn btn-primary">Update Student</button>
    </form>
</div>
